        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(flashsale_sale_cache_total[1m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
