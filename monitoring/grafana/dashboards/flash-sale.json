        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rate limiter per second",
      "id": 15,
      "description": "Per-buyer token buckets (the per-IP limit is in nginx and doesn't reach the app).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(flashsale_rate_limit_total[1m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
