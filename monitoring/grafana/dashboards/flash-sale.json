        }
      }
    },
    {
      "type": "timeseries",
      "title": "Notifications per second",
      "id": 20,
      "description": "sent, duplicate (a second delivery, skipped), dead_lettered, unreadable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(flashsale_notifications_total[1m]))",
