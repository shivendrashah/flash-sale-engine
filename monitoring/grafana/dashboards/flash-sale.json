      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(flashsale_waiting_room_total[1m]))",
